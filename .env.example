# Copy this file to .env.local and fill in real values.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser (safe for public
# identifiers only, never secrets). Values are inlined at build time, so the
# build must run with these set.

# Razorpay Key ID (public identifier, not the secret).
# Dashboard -> Settings -> API Keys. rzp_test_... for testing, rzp_live_...
# for real charges. Powers the Pro plan checkout on /dashboard/plans.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
