# Copy this file to .env.local and fill in real values.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser (safe for public
# identifiers only, never secrets). Values are inlined at build time, so the
# build must run with these set.

# Razorpay Key ID (public identifier, not the secret).
# Dashboard -> Settings -> API Keys. rzp_test_... for testing, rzp_live_...
# for real charges. Powers the Pro plan checkout on /dashboard/plans.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Backend API origin, read on the server only (no NEXT_PUBLIC prefix).
# The app proxies browser calls to it through /api/upstream, so the backend
# may speak plain http even when this site is served over https.
API_UPSTREAM_URL=http://your-api-host:8010

# Optional: call the backend straight from the browser instead of proxying.
# Only safe when this site is served over http, or when the backend has its
# own https certificate. Leave unset in production.
# NEXT_PUBLIC_API_BASE_URL=http://your-api-host:8010
